# --- secrets & state (NEVER commit) ---
.env
data/
logs/
*.sqlite3
*.db

# --- python ---
.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# --- os / editor ---
.DS_Store
~/
*.swp

# --- desktop ---
# repo-level dist/ and build/ ignores must not swallow the Tauri scaffold
!desktop/dist/
!desktop/dist/index.html

# packet compile intermediates (render copies the template beside the data)
applications/*/resume.typ
applications/*/packet-data.json
