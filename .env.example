# jobscout environment — copy to .env and fill in.
# .env is gitignored. Only ever needed on the machine that runs LLM calls.

# LLM provider (OpenAI-compatible endpoint: OpenRouter, DeepSeek direct, etc.)
# Tier models are configured in config/models.yaml; this key authorizes all of them.
JOBSCOUT_LLM_API_KEY=
JOBSCOUT_LLM_BASE_URL=https://openrouter.ai/api/v1

# Google Programmable Search Engine (free 100 queries/day) — discovery agent
# Create at https://programmablesearchengine.google.com (enable "search entire web")
JOBSCOUT_CSE_API_KEY=
JOBSCOUT_CSE_CX=

# Brave Search API (free tier, agent fallback) — https://brave.com/search/api/
JOBSCOUT_BRAVE_API_KEY=
